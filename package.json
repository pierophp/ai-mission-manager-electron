{
  "name": "ai-mission-manager-electron",
  "version": "1.0.0",
  "private": true,
  "description": "AI Mission Manager desktop app",
  "homepage": "https://github.com/pierophp/ai-mission-manager-electron#readme",
  "bugs": {
    "url": "https://github.com/pierophp/ai-mission-manager-electron/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierophp/ai-mission-manager-electron.git"
  },
  "type": "commonjs",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "vp build --config vite.main.config.ts && vp build --config vite.preload.config.ts && concurrently -k \"vp dev --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "vp build --config vite.main.config.ts && vp build --config vite.preload.config.ts && vp build",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "check": "vp check src vite.config.ts vite.main.config.ts vite.preload.config.ts forge.config.cjs package.json README.md tsconfig.json && tsc --noEmit",
    "test": "vp test && tsc --noEmit"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.13.1",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  }
}
